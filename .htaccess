# Generated by build.py from REDIRECTS.csv. Upload only after approval and Apache QA.
DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
RewriteEngine On
RewriteRule ^acquisto\-cimeli\-militari/$ https://www.sgomberocatania.it/acquisto-cimeli-militari-a-catania/ [R=301,L,NE]
RewriteRule ^acquisto\-lampade/$ https://www.sgomberocatania.it/acquisto-lampadari-catania/ [R=301,L,NE]
RewriteRule ^catania$ https://www.sgomberocatania.it/catania/ [R=301,L,NE]
RewriteRule ^contact$ https://www.sgomberocatania.it/contact/ [R=301,L,NE]
RewriteRule ^contatti/$ https://www.sgomberocatania.it/contact/ [R=301,L,NE]
RewriteRule ^home/$ https://www.sgomberocatania.it/ [R=301,L,NE]
RewriteRule ^privacy\.html$ https://www.sgomberocatania.it/privacy/ [R=301,L,NE]
RewriteRule ^servizi/$ https://www.sgomberocatania.it/servizi-2/ [R=301,L,NE]
RewriteRule ^sgomberi\-uffici/$ https://www.sgomberocatania.it/sgombero-uffici/ [R=301,L,NE]
RewriteRule ^sgomberi\-zone\-etnee\-specializzazione$ https://www.sgomberocatania.it/sgomberi-zone-etnee-specializzazione/ [R=301,L,NE]
RewriteRule ^sgombero\-abitazioni$ https://www.sgomberocatania.it/sgombero-abitazioni/ [R=301,L,NE]
RewriteRule ^sgombero\-appartamenti/$ https://www.sgomberocatania.it/sgombero-abitazioni/ [R=301,L,NE]
RewriteRule ^sgombero\-negozi$ https://www.sgomberocatania.it/sgombero-negozi/ [R=301,L,NE]
RewriteRule ^sgombero\-uffici$ https://www.sgomberocatania.it/sgombero-uffici/ [R=301,L,NE]
RewriteRule ^smaltimento\-mobili$ https://www.sgomberocatania.it/smaltimento-mobili/ [R=301,L,NE]
# Direct index and trailing-slash normalization, one hop to canonical origin.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ https://www.sgomberocatania.it/$1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://www.sgomberocatania.it/$1/ [R=301,L,NE]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.sgomberocatania\.it$ [NC]
RewriteRule ^ https://www.sgomberocatania.it%{REQUEST_URI} [R=301,L,NE]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
